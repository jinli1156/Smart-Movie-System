  {
    "type": "function",
    "function": {
      "name": "quote_price",
      "description": "只读试算当前登录用户的最优优惠券与积分组合。提供showtimeId+people，或者仅orderNo，二选一；金额从数据库取，不接受用户提供价格或身份。usePoints默认true，可显式false保留积分。返回原价、券抵扣、积分消耗、预计实付，不支付不占券。",
      "parameters": {
        "type": "object",
        "properties": {
          "showtimeId": {
            "type": "integer",
            "minimum": 1
          },
          "people": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "orderNo": {
            "type": "string"
          },
          "usePoints": {
            "type": "boolean",
            "description": "是否比较使用积分的方案，默认true；用户不想用积分时false"
          }
        },
        "additionalProperties": false
      }
    }
  }
