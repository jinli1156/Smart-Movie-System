  {
    "type": "function",
    "function": {
      "name": "recommend_seats",
      "description": "复用智能选座算法，按指定真实场次、人数和自然语言偏好推荐可用连座。返回座位方案供用户点击进入选座页预选，不锁座不下单。无候选时明确无合适连座。",
      "parameters": {
        "type": "object",
