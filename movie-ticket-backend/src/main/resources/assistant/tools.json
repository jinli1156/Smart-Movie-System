          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "genre": {
            "type": "string",
            "description": "题材关键词，如科幻"
          },
          "minRating": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "description": "本系统评分下限，含边界"
          },
          "maxDuration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "影片时长上限，分钟，含边界"
          },
          "startAfter": {
            "type": "string",
            "description": "HH:mm，当天开场时间下限，含边界"
          },
          "startBefore": {
            "type": "string",
            "description": "HH:mm，当天开场时间上限，不含边界；跨午夜分两天查询"
          },
          "hallKeyword": {
            "type": "string",
            "description": "按影厅名称匹配，如IMAX、杜比。不是官方制式认证"
