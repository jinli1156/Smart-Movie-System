[
  {
    "type": "function",
    "function": {
      "name": "prepare_ticket_order",
      "description": "用户已确定场次并希望下单时，读取本次showtimeId、people和观影条件，重新校验场次、推荐座位、计算优惠，生成5分钟有效的订单确认卡。必须先update_watch_plan保存条件。本工具只准备确认卡，不锁座、不创建购票订单、不支付；用户在页面确认后才创建待支付订单。",
      "parameters": {"type": "object", "properties": {}, "additionalProperties": false}
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_watch_plan",
      "description": "增量更新本次观影条件。只提供用户新增或修改的字段，其余保留；null删除单项。先处理候选指代，再改时间或预算。此工具不查询库存、不购票、不保存长期偏好。",
      "parameters": {
        "type": "object",
        "properties": {
          "movieId": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "cinemaId": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "description": "YYYY-MM-DD，北京时间"
          },
          "maxPrice": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100000,
            "description": "票价上限，单位元，最多两位小数；实际基础票价，不假设优惠"
          },
          "priceExclusive": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "true为严格小于上限（低于/以下），false为小于等于（不超过/以内），默认false"
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 3
          },
          "genre": {
            "type": [
              "string",
              "null"
            ],
            "description": "题材关键词，如科幻"
          },
          "minRating": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10,
            "description": "本系统评分下限，含边界"
          },
          "maxDuration": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 1000,
            "description": "影片时长上限，分钟，含边界"
          },
          "startAfter": {
            "type": [
              "string",
              "null"
            ],
            "description": "HH:mm，当天开场时间下限，含边界"
          },
          "startBefore": {
            "type": [
              "string",
              "null"
            ],
            "description": "HH:mm，当天开场时间上限，不含边界；跨午夜分两天查询"
          },
          "hallKeyword": {
            "type": [
              "string",
              "null"
            ],
            "description": "按影厅名称匹配，如IMAX、杜比。不是官方制式认证"
          },
          "cinemaKeyword": {
            "type": [
              "string",
              "null"
            ],
            "description": "影院名称或地址关键词，如南宁，不代表定位或距离"
          },
          "people": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          },
          "showtimeId": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "固定场次；换日期或寻找其他场次时清除此项"
          },
          "endBefore": {
            "type": [
              "string",
              "null"
            ],
            "description": "HH:mm，当天结束时间上限，含边界，和开场时间不同"
          },
          "maxTotal": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100000,
            "description": "全部人数优惠后的总预算，不能换算成基础单价过滤"
          },
          "usePoints": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "useCoupons": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "requireTogether": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "多人默认需要连座；只有用户接受分散座位才设false"
          },
          "preference": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "CENTER",
              "QUIET",
              "EASY_ACCESS",
              "COUPLE",
              "ACCESSIBLE",
              null
            ]
          },
          "naturalLanguage": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "用户座位偏好原文，属于软偏好"
          },
          "excludedGenres": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 20
            },
            "description": "完整排除类型列表；新增时保留已有项，[]表示本次清除"
          },
          "excludedMovieIds": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 50,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "description": "已看过或不喜欢的真实影片ID；新增时保留已有项"
          },
          "scene": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "RELAXED",
              "DATE",
              "FAMILY",
              "FRIENDS",
              "SOLO",
              null
            ],
            "description": "轻松、约会、家庭、朋友聚会、独自观影；软排序依据，不是内容分级"
          },
          "reset": {
            "type": "boolean",
            "description": "清空本次观影条件，只在用户要求重新开始时使用"
          },
          "selectOption": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "description": "按本次上下文options的1起始编号选定影片或场次；不要猜ID"
          },
          "rejectOptions": {
            "type": "boolean",
            "description": "用户表示这批都看过或都不喜欢时，把历史候选的影片加入本次排除列表"
          }
        },
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "plan_movie_outing",
      "description": "根据已保存的本次观影条件查询完整方案：统一筛选日期/开场/结束时间/题材/排除/影院，核算优惠后总价，再验证真实连座。必须先update_watch_plan，人数未知先澄清。参数为空对象。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "discover_movies",
      "description": "按本次类型、评分、时长、排除项和场景筛选真实影片，返回场景匹配依据。仅找影片时无需人数；有购票预算或时间要求使用plan_movie_outing。参数为空对象。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "compare_prices",
      "description": "同一电影跨影院、跨场次智能比价。提供真实movieId或showtimeId（二选一）和人数；场次可自动识别电影及观影日期，电影默认今天。全量筛选当日可购场次后，按本人优惠券和积分后的总实付排序，返回前10项。访客仅比较原价。maxTotal是所有人的优惠后总预算，不能当作单张票价。只读、不支付、不占券、不扣积分、不保证连座。",
      "parameters": {
        "type": "object",
        "properties": {
          "movieId": {
            "type": "integer",
            "minimum": 1
          },
          "showtimeId": {
            "type": "integer",
            "minimum": 1
          },
          "people": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "date": {
            "type": "string",
            "description": "YYYY-MM-DD，北京时间"
          },
          "usePoints": {
            "type": "boolean",
            "description": "默认true，保留积分时false"
          },
          "useCoupons": {
            "type": "boolean",
            "description": "默认true，保留优惠券时false"
          },
          "maxTotal": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "required": [
          "people"
        ],
        "additionalProperties": false
      }
    }
  },
  {
