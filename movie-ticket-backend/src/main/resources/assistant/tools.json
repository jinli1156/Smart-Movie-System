              "CENTER",
              "QUIET",
              "EASY_ACCESS",
              "COUPLE",
              "ACCESSIBLE"
            ]
          },
          "naturalLanguage": {
            "type": "string",
            "description": "座位偏好原文，最多200字；属于软偏好，不保证指定排号"
          },
