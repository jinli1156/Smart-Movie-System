# Spring Boot 不会自动读取本文件；请把变量配置到操作系统或 IDE 运行配置中。
# 本文件只能保留示例值，不要提交真实凭据。
DB_URL=jdbc:mysql://localhost:3306/movie_ticket?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-characters
DEEPSEEK_API_KEY=replace-with-your-key
AI_ASSISTANT_MODEL=deepseek-v4-flash
AI_ASSISTANT_BASE_URL=https://api.deepseek.com

# 生图服务（与文案/语言模型配置独立）
MARKETING_IMAGE_PROVIDER=qwen-images
MARKETING_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
MARKETING_IMAGE_MODEL=qwen-image-3.0
MARKETING_IMAGE_API_KEY=replace-with-your-image-key

# AI 观影纪念票：复用上述生图配置，固定星空科幻主题
SOUVENIR_WORKER_ENABLED=true
SOUVENIR_STORAGE_PATH=../.local/souvenir-assets
SOUVENIR_DAILY_LIMIT=6

# AI 辅助上架：文字提取复用 DEEPSEEK_API_KEY；海报识别使用独立视觉模型
# 不设置视觉密钥时，尝试复用 marketing.zhipu-api-key。
LISTING_VISION_API_KEY=replace-with-your-vision-key
LISTING_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LISTING_VISION_MODEL=glm-4.6v-flash
LISTING_PROXY_URL=http://127.0.0.1:7890
